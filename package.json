{
  "name": "diskgrove",
  "version": "1.0.0",
  "description": "Cross-platform disk space analyzer",
  "desktopName": "diskgrove.desktop",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Tanmay Patel",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tanmay-73/diskgrove.git"
  },
  "bugs": {
    "url": "https://github.com/tanmay-73/diskgrove/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark": "vitest run --config vitest.benchmark.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "icons": "electron scripts/build-icons.mjs",
    "dist": "electron-vite build && electron-builder",
    "pack": "electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.13",
    "@tanstack/react-virtual": "^3.13.12",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-hierarchy": "^3.1.2",
    "electron": "^44.9.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.544.0",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.6.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-resizable-panels": "^4.14.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.6",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "global-agent": "^4.1.3"
  }
}
