<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and recent scan paths stay on this device: Android 12 and later ignore allowBackup="false" for
     device-to-device transfers, so every domain is excluded from each kind of backup and transfer here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
    <cross-platform-transfer platform="ios">
        <exclude domain="root" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="external" path="." />
    </cross-platform-transfer>
</data-extraction-rules>
