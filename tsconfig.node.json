{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2023"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "capacitor.config.ts",
    "vite.android.config.ts",
    "vitest.config.ts",
    "vitest.benchmark.config.ts",
    "benchmarks/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/android/api.ts",
    "src/android/features.ts",
    "src/android/native-api.ts",
    "src/android/scanner.ts",
    "src/android/shims/**/*",
    "src/renderer/src/lib/platform.ts"
  ]
}
